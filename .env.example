# Supabase (Project settings -> API keys)

# Your project URL, from Project settings -> Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser: RLS is on every table.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_...). Bypasses RLS. Server only, never a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Salt for hashing viewer IPs. Any long random string (min 8 chars).
IP_HASH_SALT=change-me-to-a-long-random-string

# Public origin, used to build share links. Defaults to http://localhost:3000.
VITE_PUBLIC_URL=

# Billing (Stripe). Optional: without them the free plan works and every
# billing path says "not switched on yet" instead of throwing.
# Secret key (sk_test_... while testing) from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint pointed at
# <your-origin>/api/stripe/webhook. From the endpoint, not the API keys page.
STRIPE_WEBHOOK_SECRET=
# The recurring price the Solo button charges. Created by
# scripts/stripe-setup.mjs, or copied from the dashboard.
STRIPE_PRICE_SOLO=
# Studio is not open yet; leave empty.
STRIPE_PRICE_STUDIO=

# Optional. Cloudflare Web Analytics site token, from the Cloudflare dashboard
# under Analytics & Logs -> Web Analytics -> Add a site. Baked into the client
# bundle at build time, so a change needs a rebuild. Leave empty and no beacon
# is rendered; it never loads on /p/ share links either way.
VITE_CF_BEACON_TOKEN=http://localhost:3000

# Email (Resend). Optional: the "first qualified open" notification is disabled
# until RESEND_API_KEY is set, so the app runs fine without these.
# Key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender. Use a domain you own in production; onboarding@resend.dev
# works for testing to your own address. Defaults to Closewatch <onboarding@resend.dev>.
EMAIL_FROM=Closewatch <notify@yourdomain.com>
