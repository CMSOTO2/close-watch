# Supabase (Project settings -> API keys)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser: RLS is on every table.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...). Bypasses RLS. Server only, never a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Salt for hashing viewer IPs. Any long random string.
IP_HASH_SALT=change-me

# Public origin, used to build share links
VITE_PUBLIC_URL=http://localhost:3000
