# Cloudflare static-asset headers. Everything under /assets/ is emitted by Vite
# with a content hash in its name, so a given URL never changes: cache it for a
# year and skip the revalidation round trip. Without this the default is
# max-age=0, and every repeat visit re-checks ~35 script chunks and the fonts.
# Nothing else is listed here: og.png, the favicons and /images/ keep their
# names across changes and must stay revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
